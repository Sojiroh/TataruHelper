<UserControl x:Class="FFXIVTataruHelper.ChatTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <RichTextBox x:Name="ChatRtb" Background="Transparent" BorderThickness="0"
                 IsReadOnly="True" IsUndoEnabled="False" AcceptsTab="True"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 FontFamily="{Binding ChatFont}" FontSize="{Binding ChatFontSize}">
        <RichTextBox.Style>
            <Style TargetType="RichTextBox">
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </RichTextBox.Style>
        <FlowDocument TextAlignment="Left" PagePadding="0"
                      ColumnWidth="{Binding ActualWidth, ElementName=ChatRtb}" />
        <RichTextBox.Resources>
            <Style TargetType="Paragraph">
                <Setter Property="Margin" Value="0" />
                <Setter Property="TextAlignment" Value="Left" />
            </Style>
        </RichTextBox.Resources>
    </RichTextBox>
</UserControl>
